# vibe-agent-core 配置示例
#
# 用法：把需要的项复制到环境变量，或写进 .env 后在启动脚本里加载。
# 所有变量都是可选的，不设置则使用内置默认值。
# 优先级：命令行参数 > 环境变量 > 默认值。

# ---------------------------------------------------------------------------
# 模型接入
# ---------------------------------------------------------------------------
# 模型名。Ollama 上先 `ollama pull qwen2.5-coder:7b`
VIBE_MODEL=qwen2.5-coder:7b

# OpenAI 兼容接入地址。注意下面几种写法的区别：
#   Ollama 本地   http://127.0.0.1:11434/v1
#   内网 vLLM     http://gpu-node:8000/v1
#   DeepSeek      https://api.deepseek.com/v1
VIBE_BASE_URL=http://127.0.0.1:11434/v1

# API Key。本地模型通常随便填（Ollama 默认就是 ollama）。
# 生产环境请交由服务端密钥托管注入，不要写进代码或提交到仓库。
VIBE_API_KEY=ollama

# 用户级「模型设置」真源路径。留空 = ~/.vibe/settings.json。
# 界面顶部的「模型设置」面板保存的就是这个文件（只存 model / base_url / api_key）。
# 生效优先级：环境变量 > 该文件 > CLI/桌面 config.json > 内核默认。
# 只要 VIBE_MODEL / VIBE_BASE_URL / VIBE_API_KEY 任一被设置，对应字段即被锁死，
# 界面里置灰不可改（这是刻意的：运维钉死的值不该被界面悄悄盖掉）。
VIBE_SETTINGS=

# 采样温度。改代码场景建议保持低温，0.1 左右
VIBE_TEMPERATURE=0.1

# 单次请求超时（秒）。本地大模型首 token 可能很慢，长上下文时适当调高
VIBE_REQUEST_TIMEOUT=300

# 流式输出。推理端不支持 SSE 时会自动回退一次性请求；这个开关是给
# 「回退也失败」的极端环境留的手动闸。1 = 流式；0 = 一次性。
VIBE_STREAM=1

# ---------------------------------------------------------------------------
# 循环与上下文
# ---------------------------------------------------------------------------
# 单轮任务的最大迭代次数
VIBE_MAX_ITERATIONS=25

# 上下文字符预算，超出后从最早的消息开始裁剪（默认 400000，与治理面策略默认一致）
VIBE_MAX_CONTEXT_CHARS=400000

# 上下文裁剪的 token 预算（P2-17）。默认 0 = 未启用，沿用上面的字符口径；
# >0 时启用 token 口径（估算：探测到 tiktoken 用它，否则回退启发式，见 ADR-020）。
VIBE_CONTEXT_BUDGET_TOKENS=0

# prompt caching（P2-17）：auto / on / off。
#   auto（默认）— 第一次真实请求带上 prompt_cache_key，上游 400/422 且报错含字段名
#                  就判定不支持，永久回退（请求体与不带键时一致）；
#   on           — 总是注入稳定 cache key（cache_key 取 session_id）；
#   off          — 不注入，请求体与改造前逐字节一致。
# 非法值在启动前直接报错，不静默兜底。
VIBE_PROMPT_CACHE=auto

# 上下文裁剪升级：裁剪前先把待删的一段历史交给模型压成摘要，而不是直接丢弃。
# 默认 0（关）—— 摘要会给每次裁剪多一轮模型调用（有成本、可能失败）。
# 1 = 摘要压缩；0 = 直接裁剪。
VIBE_COMPACT_ON_TRIM=0

# 单个工具返回结果的字符上限，超出后首尾保留、中间省略
VIBE_TOOL_OUTPUT_LIMIT=8000

# ---------------------------------------------------------------------------
# 会话持久化（M1.5-A2）
# ---------------------------------------------------------------------------
# 是否把本机会话正文落盘（SQLite）。1 = 持久化（默认）；0 = 关，进程退出即丢。
# 库存的是本机会话正文，与「服务端不存正文」不冲突（ADR-006）。
VIBE_SESSION_PERSIST=1

# 会话库路径。留空 = ~/.vibe/sessions.db（测试/便携场景可覆盖）。
VIBE_SESSION_DB=

# ---------------------------------------------------------------------------
# 验证与测试命令（C2 验证闭环 / P2-14 测试树）
# ---------------------------------------------------------------------------
# 收尾前自动执行的验证命令（如跑测试）；空 = 不验证。
# 优先级：VIBE_VERIFY_COMMAND > VIBE.md 的 `verify:` 约定行 > 空。
# 命令本身免审批但过 CommandGuard 白名单，模型无法在运行时改写它。
VIBE_VERIFY_COMMAND=

# IDE 测试树跑单个/整批用例的命令（如 `python -m pytest -q`）；空 = 面板显示
# 「未配置测试命令」。与 verify 同范式：来自用户配置（环境变量 / VIBE.md 的
# `test:` 约定行），模型运行时改不了，执行前仍过 CommandGuard 白名单。
VIBE_TEST_COMMAND=

# 收集用例时追加的参数（pytest 的 `--collect-only -q` 会逐行输出 node id）。
# 换测试框架时只改这一条（当前只保证 pytest）。
VIBE_TEST_COLLECT_ARGS=--collect-only -q

# ---------------------------------------------------------------------------
# 安全开关
# ---------------------------------------------------------------------------
# 写权限。设为 false 等价于命令行 --read-only
VIBE_ALLOW_WRITE=true

# 命令执行权限。设为 false 等价于命令行 --no-shell
VIBE_ALLOW_SHELL=true

# 是否允许网络类命令（curl / wget / ssh / rsync）。
# 默认 false —— 这是数据外发的主要通道，非必要不要打开。
VIBE_ALLOW_NETWORK_COMMANDS=false

# 是否允许把 .env / *.pem / id_rsa 一类敏感文件读入模型上下文。
# 默认 false。除非你明确知道自己在做什么，否则不要开启。
VIBE_ALLOW_SENSITIVE_READ=false

# 单条命令的超时（秒），上限 600
VIBE_COMMAND_TIMEOUT=60

# 注意：REVIEW 级（文件写入 / 命令执行）审批**不可配置关闭**（ADR-008）。
# 原 VIBE_AUTO_APPROVE_REVIEW 开关已移除，此处不再提供该项。

# ---------------------------------------------------------------------------
# 语义检索（P0-B）
# ---------------------------------------------------------------------------
# embedding 模型名（OpenAI 兼容 /embeddings）。
# 留空 = 不构造 embedding 客户端，semantic_search 走纯词法 + 符号/依赖图
# —— 功能可用，只是精度降一档。绝不因为探不到端点而失败。
# 注意：若配成公网端点，源码片段会离开本机，这是你的显式选择（ADR-005/012）。
VIBE_EMBED_MODEL=

# 单次建索引最多读多少个文件，防止超大仓库把内存与耗时拉爆
VIBE_SEMANTIC_MAX_FILES=800

# ---------------------------------------------------------------------------
# 增量索引 / 文件监听（P1-9）
# ---------------------------------------------------------------------------
# 是否后台监听工作区文件变化并增量更新索引。默认 false（行为与改造前逐字节一致：
# 不启线程、不做额外索引）。开启后用 (mtime_ns, size) 快照轮询 diff，
# 纯 stdlib、不引入 watchdog（见 ADR-012 红线），索引只驻内存、不落盘（ADR-013）。
# 1 = 开启；0 = 关闭。
VIBE_INDEX_WATCH=0

# 轮询间隔（秒）。强制下限 2（低于 2 会被抬到 2），避免高频 stat 拖慢工作区。
VIBE_INDEX_WATCH_INTERVAL=5

# ---------------------------------------------------------------------------
# 内联补全 / 行内改写（P0-D）
# ---------------------------------------------------------------------------
# 补全是否优先走 FIM（/completions + suffix）。0 = 直接 chat()。
# 上游不支持 FIM 时也会自动回退（能力探测结果按客户端实例缓存，见 ADR-012）。
# 补全只产文本、不落盘，因此不触发审批闸门（ADR-011）。
VIBE_FIM=1

# 单次补全的输出 token 上限。补全贵在「快」，给太大反而拖慢首字
VIBE_COMPLETION_MAX_TOKENS=256

# 喂给模型的光标前 / 后上下文字符数（行对齐截断）。0 = 不截断。
# 大文件不能整份上送，否则 token 不可控、首字变慢；前后端用同一套截断算法，
# 后端为权威裁断。前缀保留尾部整行、后缀保留头部整行（不喂半行给模型）。
VIBE_COMPLETION_PREFIX_CHARS=4000
VIBE_COMPLETION_SUFFIX_CHARS=2000

# ---------------------------------------------------------------------------
# 语言服务器 / LSP（P0-E）
# ---------------------------------------------------------------------------
# 开关，取值 auto / on / off（非法值在启动前直接报错，不静默兜底）：
#   auto（默认）— 用 shutil.which 探测到语言服务器就启用，探不到就静默降级；
#   on           — 强制要求；探测不到时端点仍返回 available:false 及原因，
#                  **不做任何远端回退**（本机 stdio 是唯一形态，见 ADR-014）；
#   off          — 完全关闭：不探测、不启动任何子进程。
# 探测表：python→pyright-langserver/pylsp、js/ts→typescript-language-server、
# go→gopls、rust→rust-analyzer。缺哪个就少哪个语言的诊断，不影响其它功能。
VIBE_LSP=auto

# 空闲多少秒后自动 shutdown 语言服务器进程（**不常驻**）。0 = 不自动回收。
VIBE_LSP_IDLE=300

# ---------------------------------------------------------------------------
# 外部 MCP server（P1-6）
# ---------------------------------------------------------------------------
# 是否接入外部 MCP server。默认 false（行为与改造前逐字节一致：不读配置、
# 不起任何 MCP 子进程）。开启后按下面的配置文件发现工具并并入工具清单，
# 工具名形如 mcp__<server>__<tool>（前缀隔离）。
# 注意：外部工具**恒 REVIEW**、每次调用都需人工审批，且不可配置放行（见 ADR-015）。
# 1 = 开启；0 = 关闭。
VIBE_MCP=0

# MCP servers 配置文件路径（JSON）。留空 = <工作区>/.vibe/mcp.json。
# server 的 command/args 只取自该文件，**绝不接受运行时用户输入拼命令**；
# 子进程以 shell=False 直启、cwd 锁工作区、env 过 scrub_env() 剥离凭据。
VIBE_MCP_CONFIG=

# 单个 MCP 请求（initialize / tools/list / tools/call）的超时（秒）。
VIBE_MCP_TIMEOUT=30

# ---------------------------------------------------------------------------
# 交互式终端（P1-7）
# ---------------------------------------------------------------------------
# 是否启用交互式终端（用户在 IDE 里直接敲命令的 PTY）。默认 true。
# 0 = 关闭：界面隐藏终端页签、/api/term/* 拒绝，Agent 通道不受影响。
# 注意：终端是**用户本人动作**，不走审批浮层，但 term.open/term.close 记审计；
# 它与 Agent 通道**彻底隔离**——Agent 仍只能走受审批的 run_command（见 ADR-016）。
VIBE_TERM=1

# 终端启动的 shell 可执行文件。留空 = 按平台默认：
# Unix 用 $SHELL（缺则 sh），Windows 用 powershell.exe。
VIBE_TERM_SHELL=

# 同时存在的终端会话上限。达到上限时 open 明确拒绝。
VIBE_TERM_MAX=3

# ---------------------------------------------------------------------------
# 多模态图片输入（P1-10）
# ---------------------------------------------------------------------------
# 图片输入模式：off / auto / on。默认 off —— 图片会**随请求发往你配置的模型端点**，
# 该端点非本地时图片会离开本机，因此必须显式开启：
#   off  = 关闭：界面隐藏选图入口、image 引用降级为提示、请求体逐字节不变；
#   auto = 首次带图探测上游是否支持，400/422 且报错含图片相关词即永久回退为纯文本；
#   on   = 假定上游支持，不做探测（带图直接发）。
# 图片只落本机 <工作区>/.vibe/images/；审计 image.upload 只记 {bytes, ext, digest}。
VIBE_VISION=off

# 单张图片字节上限（落盘前校验）。超过即拒绝，提示压缩后重试或调大本值。
VIBE_VISION_MAX_BYTES=4000000

# ---------------------------------------------------------------------------
# 规则与记忆体系（P2-15）
# ---------------------------------------------------------------------------
# 仓库级规则文件的**附加目录**（glob，相对工作区）。
# 规则按「全局级 → 用户级 → 仓库级 → 附加目录 → 目录级」多层合并；单层无抬头
# （逐字节兼容改造前），多层各带一行 `### 规则来源：<source>` 抬头。
# 仓库级 = VIBE.md；用户级 = ~/.vibe/rules.md（存在才读）。
VIBE_RULES_EXTRA=

# 全局规则目录（M9-B）：跨仓库共享的规则目录（公司统一编码规范等），
# 作为最泛层被任意工作区继承。目录下 *.md 按文件名排序加载。
# 空 = 无继承、合并结果与改造前逐字节一致（默认）。
VIBE_RULES_GLOBAL=

# 全局层规则合计字节上限。超限丢弃文件名排序后的队尾并如实标注。
VIBE_RULES_GLOBAL_MAX_BYTES=64000

# 是否启用跨会话记忆（本地 SQLite 记忆库）。默认 true。
# 0 = 关闭：不建库、不注入、不注册 remember 工具，行为与改造前逐字节一致。
# 记忆正文属**不可信内容**，检索注入时一律 wrap_untrusted 包裹。
VIBE_MEMORY=1

# 记忆库容量上限（条）。达上限时写入明确拒绝（不静默淘汰）。
VIBE_MEMORY_MAX=200

# 单轮任务最多注入几条相关记忆（按词法相关度取 top-N）。0 = 不注入。
VIBE_MEMORY_INJECT=5

# 记忆库文件路径。留空 = ~/.vibe/memories.db（用户级，跨工作区）。
VIBE_MEMORY_DB=

# 注意：remember 工具**恒为 REVIEW 级**（必须人工审批），不可配置关闭（ADR-008）。
# 记忆会被注入后续每轮提示，是持久化注入面，故写入一定经用户确认，禁止静默自动学习。

# ---------------------------------------------------------------------------
# 多 Agent 编排（M3）
# ---------------------------------------------------------------------------
# 是否启用主从只读子 Agent。默认 false（行为与改造前逐字节一致：不注册 task 工具、
# 无 run.subagent 事件、工具清单不变）。开启后父 Agent 可经 task 工具派生一个**只读**
# 子 Agent 做探索/分析/检索，子 Agent 把结论压成要点回传（见 ADR-022）。
# 边界：子 Agent **只读**（只读白名单 + allow_write=False 纵深防御）、**无递归**
# （子表不含 task）、**共用父的审计实例**（否则哈希链断裂）、写盘一律回到父走审批。
# 1 = 开启；0 = 关闭。
VIBE_SUBAGENT=0

# 单个子 Agent 的迭代上限（独立于父的 VIBE_MAX_ITERATIONS）。默认 8。
# 上限越低越省 token，但复杂探索可能探索不完；子 Agent 恒只读，无写盘/无命令。
VIBE_SUBAGENT_MAX_ITERATIONS=8

# ---------------------------------------------------------------------------
# 检索增强 / Repo Wiki（M3+）
# ---------------------------------------------------------------------------
# 语义检索增强。默认 false（行为与改造前逐字节一致：分词/分块/融合都走旧路径）。
# 开启后 semantic_search 走三处增强：① 标识符子词化（getUserName → get/user/name）、
# ② 符号感知分块（块边界优先对齐函数/类起点）、③ 词法+向量 RRF 融合并按文件去冗余。
# **不新增依赖**：embedding 仍是可选端点（VIBE_EMBED_MODEL），缺则回退纯词法。
# 1 = 开启；0 = 关闭。
VIBE_RETRIEVAL_ENHANCED=0

# 是否启用 Repo Wiki 生成。默认 false（行为与改造前逐字节一致：不注册 repo_wiki 工具、
# 工具清单不变）。开启后 Agent 可用 repo_wiki 生成**本机代码结构**驱动的 markdown Wiki
# （总览 + 模块页）；落盘恒走结构化补丁 + 审批（ADR-004），正文不出机（ADR-006）。
# 1 = 开启；0 = 关闭。
VIBE_WIKI=0

# Wiki 落点（相对工作区的目录）。默认 docs/wiki。
# **不要设成 .vibe/** —— 那是审计与检查点专用目录，会被 PathGuard 拒绝写入。
VIBE_WIKI_DIR=docs/wiki

# 单次生成最多覆盖多少个源文件（防止超大仓库拉爆内存与耗时；超出会显式截断标注）。默认 400。
VIBE_WIKI_MAX_FILES=400

# ---------------------------------------------------------------------------
# 受控联网检索（M7）
# ---------------------------------------------------------------------------
# 是否启用联网检索工具 web_search / web_fetch。默认 false（行为与改造前
# 逐字节一致：不注册工具、界面无入口）。**这两个工具恒 REVIEW 级审批**
# （ADR-008，同 MCP 前例）：查询词 / URL 是外发内容，必须先经人工确认。
# 治理面策略字段 allowWeb 可一刀切禁（只收紧）。
# 1 = 开启；0 = 关闭。
VIBE_WEB=0

# 搜索上游形态：gateway / searxng（非法值启动前报错）。
#   gateway（默认）— 经治理面网关中转 POST <server>/api/v1/search，
#                    客户端零密钥、零公网出口；治理面不可达时明确报错不静默；
#   searxng        — 直连下面的 VIBE_WEB_SEARCH_URL（内网自部署零密钥形态；
#                    公共实例也可用，但外发面与直连公网等同）。
VIBE_WEB_SEARCH=gateway

# SearXNG 的 JSON 端点（searxng 形态用，gateway 形态忽略）。
# 例：http://searxng.internal:8080/search?format=json 或公共实例同路径。
VIBE_WEB_SEARCH_URL=

# 是否允许 web_fetch 访问私网/环回地址（10/8、172.16/12、192.168/16、127/8、
# 169.254/16、::1、fc00::/7）。默认 false —— 仅公网可取，SSRF 的最基本闸。
# 内网文档服务器场景才显式打开；重定向逐跳重跑校验，不会绕过。
VIBE_WEB_ALLOW_PRIVATE=0

# fetch 的 host 白名单（逗号分隔 glob，如 *.internal.example.com,docs.local）。
# 非空时仅白名单内 host 可取。黑名单恒优先于白名单。
VIBE_WEB_ALLOW_HOSTS=

# fetch 的 host 黑名单（逗号分隔 glob）。恒优先于白名单；
# 治理面策略 webDeniedHosts 下发项并进这里（只收紧）。
VIBE_WEB_DENY_HOSTS=

# 单次 web 请求超时（秒）。
VIBE_WEB_TIMEOUT=20

# 单次 fetch 字节上限。超过即整体拒绝（不截断 —— 截断的正文比没有更危险）。
VIBE_WEB_MAX_BYTES=2000000

# 搜索返回条数上限。
VIBE_WEB_MAX_RESULTS=8

# ---------------------------------------------------------------------------
# Skill / 斜杠命令（M9-A）
# ---------------------------------------------------------------------------
# 是否启用可复用工作流（Skill）。默认 0（关）—— 关着时工具清单、系统提示与
# 未实现前逐字节一致。开启后 Agent 多出一个 run_skill 工具（SAFE，只展开步骤
# 文本、不写盘、不执行），并从下面的目录加载工作流定义。
VIBE_SKILLS=0

# Skill 定义目录（相对工作区）。默认 .vibe/skills —— 每个子目录一个工作流，
# 形如 .vibe/skills/<名字>/SKILL.md（含可选 front-matter 的 name / description）。
# 注意：Skill 是**用户本人**手工放置的受信资产，与模型不可写的 .vibe/ 审计目录
# 语义不同；目录请自行创建并维护。
VIBE_SKILLS_DIR=.vibe/skills

# 单次最多加载的 Skill 文件数。
VIBE_SKILLS_MAX_FILES=50

# 加载的 Skill 正文总量上限（字节）。超限从队首丢弃并显式标注。
VIBE_SKILLS_MAX_BYTES=256000

# ---------------------------------------------------------------------------
# 测试驱动的自动修复闭环（M9-C）
# ---------------------------------------------------------------------------
# 是否启用「以测试为目标」的自动修复循环。默认 0（关）—— 关着时工具清单与
# 行为与未实现前逐字节一致。开启后 Agent 多出一个 test_loop 工具（SAFE，只调度
# 既有工具、不直接写盘/执行）：跑测试 → 失败喂回摘要 → 修复（恒走审批）→ 重跑。
VIBE_TEST_LOOP=0

# 单次闭环的重试上限。到顶仍未通过时如实报告并停止（不死循环）。
VIBE_TEST_LOOP_MAX=5

# 单次测试命令的执行超时（秒）。超时即终止本轮闭环。
VIBE_TEST_LOOP_TIMEOUT=300

# ---------------------------------------------------------------------------
# 后台 / 并行 Agent（M9-D）
# ---------------------------------------------------------------------------
# 是否启用后台任务。默认 0（关）—— 关着时无 /api/tasks 端点、行为与未实现前
# 逐字节一致。开启后用户本人可经界面发起后台任务（异步执行、结果异步回传）。
# 子任务**只读工具面**（不越权写盘）、审计链共用；后台任务由**用户本人**发起
# （不新增 Agent 派 Agent 的工具，规避递归越权，对齐 ADR-011）。
VIBE_ASYNC_AGENT=0

# 并行上限：同时最多跑多少个后台任务。超限明确拒绝新提交。
VIBE_ASYNC_AGENT_MAX=4

# 单个后台任务的超时（秒）。超时即终止并报告（防单个任务把线程池占满）。
VIBE_ASYNC_AGENT_TIMEOUT=600

# ---------------------------------------------------------------------------
# 定时任务调度（M10）
# ---------------------------------------------------------------------------
# 默认关。关着时无 /api/schedules 端点、无调度线程、无界面页签、无任务库文件，
# 事件流与未实现前逐字节一致。开启后**用户本人**可经界面 / API 创建定时任务，
# 到点把 job 的 prompt 投进 M9-D 后台任务池（**只投只读后台任务**，不新增 shell
# 通道、不新增可写盘通道）。**依赖 M9-D 池**：本项为 1 但 VIBE_ASYNC_AGENT=0 时
# 调度器不启动并在界面 notices 说明（fail-closed，不静默降级）。
# 定时任务由**用户本人**创建，**不向 Agent 暴露任何调度工具**（对齐 ADR-011）。
VIBE_SCHEDULER=0

# 任务库落点。空 → 默认 <workspace>/.vibe/scheduler.db（宿主资产，与
# .vibe/checkpoints 同范式；模型仍不可写 .vibe）。
VIBE_SCHEDULER_DB=

# 轮询粒度（秒），下限 5（防忙轮询）。
VIBE_SCHEDULER_TICK=30

# job 数上限。到顶后新建明确拒绝（400），而不是无限堆积。
VIBE_SCHEDULER_MAX=50

# 单轮最多触发几个 job（防「到点任务同时起一堆」的风暴）。
VIBE_SCHEDULER_MAX_PER_TICK=3

# 重启补跑：进程重启后对逾期 job **各补跑一次**（catch-up once，不连补 N 次）。
# 置 0 则只把 next_run_at 推到未来、不触发（并审计 action=skipped）。
VIBE_SCHEDULER_CATCHUP=1

# ---------------------------------------------------------------------------
# 预览（P2 本机应用 / P3 远端设备）
# ---------------------------------------------------------------------------
# 是否允许预览内嵌本机 dev server（`http://127.0.0.1:<port>`）。默认 0（关）。
# 关着时界面 CSP 的 frame-src 仍是 'self'（逐字节不变），POST /api/preview/external
# 回 403，中间区「浏览器」视图入口置灰。只接受 127.0.0.1 回环地址，localhost /
# https / 外部域一律 400 —— 这是"用户自己跑起来的界面"通道，不是通用浏览器。
# 桌面壳启动内核时默认注入 1（安装版开箱可用），显式设 0 仍可关闭。
VIBE_PREVIEW_EXTERNAL=0

# 是否允许把远端设备的环回端口经 `ssh -L` 转发到本机再预览（P3）。默认 0（关）。
# **另需 VIBE_REMOTE=1**（复用远程连接清单与 SSH 加固）。
VIBE_PREVIEW_REMOTE=0

# ---------------------------------------------------------------------------
# 远程设备文件工作面（M11）
# ---------------------------------------------------------------------------
# 是否启用「远程设备」能力：远程连接其他设备，对该设备上的文件做读取/审阅/
# 修改/查看/保存。默认 0（关）—— 关着时**不开端点、不渲染页签、不注册新工具**，
# 无任何远程审计事件，行为与未实现前逐字节一致（ADR「默认关」纪律）。
#
# 注意这是**同一道闸**：`VIBE_REMOTE=1` 同时打开两件东西 ——
#   ① 远程工具面（Agent 侧 8 个 tool.remote_*，既有）；
#   ② 远程工作面（用户侧连接管理 + 远程文件树/查看/审查/编辑保存，M11 新增）。
# 两者的写路径都受本机留底 + 乐观锁 + 受控结构化补丁约束（ADR-011），
# 审计一律只记元数据（路径/哈希/计数/枚举），远端文件正文一个字符都不出机（ADR-006）。
VIBE_REMOTE=0

# 远程连接清单文件路径（JSON）。留空 = <工作区>/.vibe/remote.json。
# 内容只含连接元数据（name/host/user/port/root/identity_file/proxy_jump/
# host_key_policy/超时/allow_write/allow_shell），**不含任何密钥正文**；
# 私钥只记本机路径，认证交给系统 ssh（BatchMode，不接受交互式口令）。
VIBE_REMOTE_CONFIG=

# 默认连接名。留空且清单里只有一条连接时自动选它；多条又无默认则拒绝猜测。
VIBE_REMOTE_DEFAULT=

# 启动时的「远程工作区」默认锚点（M13 / ADR-042）。取值形如
# `@remote/<连接名>/<子目录>`；留空 = 本机模式（现状，逐字节不变）。
# 非空时模型写裸相对路径（如 `src/app.py`）也落到那台远端机器上，而 `.vibe`
# 资产（审计链 / 会话库 / 检查点 / 远端写的本机留底）仍留在**本机锚点目录**
# `<家目录>/.vibe/workspaces/remote/<连接>/<指纹>/`（ADR-006 不动）。
# 这不是门控 —— 真正的开关是上面的 VIBE_REMOTE；本项给了值也绕不开它。
VIBE_REMOTE_WORKSPACE=

# ---------------------------------------------------------------------------
# 代码审阅工作流（M9-H）
# ---------------------------------------------------------------------------
# 是否启用「提交前自审」。默认 0（关）—— 关着时工具清单与行为与未实现前
# 逐字节一致。开启后 Agent 多出一个 review_changes 工具（SAFE，只读：不改盘、
# 不执行、不派子 Agent）：对「工作区相对 HEAD 的改动」组装 diff 与文件上下文，
# 由模型据此产出结构化意见（严重级别 / 类别 / 定位 / 说明 / 建议）。
# 审阅是**自审**，产出「意见」而非「补丁」，**不替代**人审（ADR-008 不变）——
# 修复仍走既有 edit_* 审批漏斗。
VIBE_REVIEW=0

# 单次审阅最多覆盖多少个文件。超上限时提示用 paths 参数收窄，而非静默截断。
VIBE_REVIEW_MAX_FILES=50

# ---------------------------------------------------------------------------
# 客户端模型选择器（M9-I）
# ---------------------------------------------------------------------------
# 是否启用「按任务难度选模型」。默认 0（关）—— 关着时请求体与行为与未实现前
# 逐字节一致。开启后按任务难度在「服务端已授权的模型集合」内选型：简单任务走
# 小模型、复杂任务走大模型。选型**只能是授权集合的子集**（只能收紧，不能选出
# 治理面未允许的上游）；选不出或越界时 fail-closed 回退默认模型。
VIBE_MODEL_ROUTER=0

# 选型策略：none（不选型，逐字节一致）/ static（固定映射）/ size（按上下文大小启发式）。
# 策略非法时回退 none 并告警，不静默生效。
VIBE_MODEL_ROUTER_POLICY=none

# 兜底模型。空 = 沿用 VIBE_MODEL。fail-closed 回退（未匹配/越界）时用这个。
VIBE_MODEL_ROUTER_DEFAULT=

# static 策略的映射表。两种写法：`小模型|大模型`（simple→小、complex→大），
# 或 `simple=小模型,complex=大模型`。留空时 static 退化、按「未匹配回退默认」处理。
VIBE_MODEL_ROUTER_STATIC_MAP=

# ---------------------------------------------------------------------------
# 治理面接入（M2 接线 / M3 落地）
# ---------------------------------------------------------------------------
# 治理面服务地址。留空 = 未接入治理面，纯本地（M0/M1）行为一行不变。
# 设置且登录过：启动时拉策略收紧本机配置、模型请求走网关（客户端永不持云端
# 密钥）、审计事件上报服务端。治理是增强而非单点依赖：服务端不可达时降级本地继续。
# 登录方式（二选一）：桌面端标题栏「治理面」按钮打开登录弹窗（密码登录 / 邀请码注册，
# 登录后热接入、无需重启，并可把地址保存进桌面壳 config.json）；或 CLI
# `vibe-agent governance login`。令牌写用户级 ~/.vibe/credentials.json（0o600）。
VIBE_SERVER_URL=

# 网关的 OpenAI 兼容基址。留空 = 由 VIBE_SERVER_URL 派生
# （<server>/api/v1/gateway/v1）。只有网关部署在另一台机器上时才需单独指定。
VIBE_GATEWAY_URL=

# 策略缓存超过该秒数视为过期，进入受限模式（仅本地、写操作强制审批）。
# 0 = 不做过期判定（单机内网、服务端常驻的场景可接受）。
VIBE_POLICY_MAX_STALENESS=0

# ---------------------------------------------------------------------------
# 客户端自动更新（M9）
# ---------------------------------------------------------------------------
# 更新通道：stable / beta / canary。发布方按通道发版，客户端按通道订阅。
VIBE_UPDATE_CHANNEL=stable

# 本地镜像基址（文件目录或 http(s) 地址，如 /srv/vibe-mirror 或 http://mirror.corp/vibe）。
# 治理面为主通道，这里只在「未接入治理面」或「治理面不可达」时兜底 ——
# 两条通道**各自独立验签**，任一条清单验签失败都会被拒，绝不因为「另一条好用」而放行。
VIBE_UPDATE_URL=

# 关闭整个更新链路（1/true）。关掉后 check/download 都不发请求。
VIBE_UPDATE_DISABLE=0

# 启动时是否自动检查更新。0 = 只手动触发（桌面端菜单 / CLI update check）。
VIBE_UPDATE_CHECK_ON_START=1

# 单个安装包的字节上限（兜底）。即使清单声明的 size 更大，也只下到这里为止。
VIBE_UPDATE_MAX_BYTES=536870912

# 安装包与更新状态的落盘目录。留空 = 用户级 ~/.vibe/updates（跨工作区共享）。
VIBE_UPDATE_DIR=

# 覆盖内置发布公钥（PEM 文件路径或 PEM 文本）。留空 = 用内核内置公钥。
# 只在自建发布链/临时验证时使用；**内置公钥才是信任锚**，覆盖它等于换信任根。
VIBE_UPDATE_PUBKEY=

# ---------------------------------------------------------------------------
# 审计
# ---------------------------------------------------------------------------
# 是否记录审计日志。默认 true，落盘在 <工作区>/.vibe/audit.jsonl
VIBE_AUDIT=true

# 会话 ID。留空则每次启动自动生成。
# 服务端统一部署时可由网关注入，便于把同一次任务的多条记录关联起来。
VIBE_SESSION_ID=
