# vibe-agent-core 配置示例
#
# 用法：把需要的项复制到环境变量，或写进 .env 后在启动脚本里加载。
# 所有变量都是可选的，不设置则使用内置默认值。
# 优先级：命令行参数 > 环境变量 > 默认值。

# ---------------------------------------------------------------------------
# 模型接入
# ---------------------------------------------------------------------------
# 模型名。Ollama 上先 `ollama pull qwen2.5-coder:7b`
VIBE_MODEL=qwen2.5-coder:7b

# OpenAI 兼容接入地址。注意下面几种写法的区别：
#   Ollama 本地   http://127.0.0.1:11434/v1
#   内网 vLLM     http://gpu-node:8000/v1
#   DeepSeek      https://api.deepseek.com/v1
VIBE_BASE_URL=http://127.0.0.1:11434/v1

# API Key。本地模型通常随便填（Ollama 默认就是 ollama）。
# 生产环境请交由服务端密钥托管注入，不要写进代码或提交到仓库。
VIBE_API_KEY=ollama

# 用户级「模型设置」真源路径。留空 = ~/.vibe/settings.json。
# 界面顶部的「模型设置」面板保存的就是这个文件（只存 model / base_url / api_key）。
# 生效优先级：环境变量 > 该文件 > CLI/桌面 config.json > 内核默认。
# 只要 VIBE_MODEL / VIBE_BASE_URL / VIBE_API_KEY 任一被设置，对应字段即被锁死，
# 界面里置灰不可改（这是刻意的：运维钉死的值不该被界面悄悄盖掉）。
VIBE_SETTINGS=

# 采样温度。改代码场景建议保持低温，0.1 左右
VIBE_TEMPERATURE=0.1

# 单次请求超时（秒）。本地大模型首 token 可能很慢，长上下文时适当调高
VIBE_REQUEST_TIMEOUT=300

# 流式输出。推理端不支持 SSE 时会自动回退一次性请求；这个开关是给
# 「回退也失败」的极端环境留的手动闸。1 = 流式；0 = 一次性。
VIBE_STREAM=1

# ---------------------------------------------------------------------------
# 循环与上下文
# ---------------------------------------------------------------------------
# 单轮任务的最大迭代次数
VIBE_MAX_ITERATIONS=25

# 上下文字符预算，超出后从最早的消息开始裁剪
VIBE_MAX_CONTEXT_CHARS=120000

# 上下文裁剪的 token 预算（P2-17）。默认 0 = 未启用，沿用上面的字符口径；
# >0 时启用 token 口径（估算：探测到 tiktoken 用它，否则回退启发式，见 ADR-020）。
VIBE_CONTEXT_BUDGET_TOKENS=0

# prompt caching（P2-17）：auto / on / off。
#   auto（默认）— 第一次真实请求带上 prompt_cache_key，上游 400/422 且报错含字段名
#                  就判定不支持，永久回退（请求体与不带键时一致）；
#   on           — 总是注入稳定 cache key（cache_key 取 session_id）；
#   off          — 不注入，请求体与改造前逐字节一致。
# 非法值在启动前直接报错，不静默兜底。
VIBE_PROMPT_CACHE=auto

# 上下文裁剪升级：裁剪前先把待删的一段历史交给模型压成摘要，而不是直接丢弃。
# 默认 0（关）—— 摘要会给每次裁剪多一轮模型调用（有成本、可能失败）。
# 1 = 摘要压缩；0 = 直接裁剪。
VIBE_COMPACT_ON_TRIM=0

# 单个工具返回结果的字符上限，超出后首尾保留、中间省略
VIBE_TOOL_OUTPUT_LIMIT=8000

# ---------------------------------------------------------------------------
# 会话持久化（M1.5-A2）
# ---------------------------------------------------------------------------
# 是否把本机会话正文落盘（SQLite）。1 = 持久化（默认）；0 = 关，进程退出即丢。
# 库存的是本机会话正文，与「服务端不存正文」不冲突（ADR-006）。
VIBE_SESSION_PERSIST=1

# 会话库路径。留空 = ~/.vibe/sessions.db（测试/便携场景可覆盖）。
VIBE_SESSION_DB=

# ---------------------------------------------------------------------------
# 验证与测试命令（C2 验证闭环 / P2-14 测试树）
# ---------------------------------------------------------------------------
# 收尾前自动执行的验证命令（如跑测试）；空 = 不验证。
# 优先级：VIBE_VERIFY_COMMAND > VIBE.md 的 `verify:` 约定行 > 空。
# 命令本身免审批但过 CommandGuard 白名单，模型无法在运行时改写它。
VIBE_VERIFY_COMMAND=

# IDE 测试树跑单个/整批用例的命令（如 `python -m pytest -q`）；空 = 面板显示
# 「未配置测试命令」。与 verify 同范式：来自用户配置（环境变量 / VIBE.md 的
# `test:` 约定行），模型运行时改不了，执行前仍过 CommandGuard 白名单。
VIBE_TEST_COMMAND=

# 收集用例时追加的参数（pytest 的 `--collect-only -q` 会逐行输出 node id）。
# 换测试框架时只改这一条（当前只保证 pytest）。
VIBE_TEST_COLLECT_ARGS=--collect-only -q

# ---------------------------------------------------------------------------
# 安全开关
# ---------------------------------------------------------------------------
# 写权限。设为 false 等价于命令行 --read-only
VIBE_ALLOW_WRITE=true

# 命令执行权限。设为 false 等价于命令行 --no-shell
VIBE_ALLOW_SHELL=true

# 是否允许网络类命令（curl / wget / ssh / rsync）。
# 默认 false —— 这是数据外发的主要通道，非必要不要打开。
VIBE_ALLOW_NETWORK_COMMANDS=false

# 是否允许把 .env / *.pem / id_rsa 一类敏感文件读入模型上下文。
# 默认 false。除非你明确知道自己在做什么，否则不要开启。
VIBE_ALLOW_SENSITIVE_READ=false

# 单条命令的超时（秒），上限 600
VIBE_COMMAND_TIMEOUT=60

# 注意：REVIEW 级（文件写入 / 命令执行）审批**不可配置关闭**（ADR-008）。
# 原 VIBE_AUTO_APPROVE_REVIEW 开关已移除，此处不再提供该项。

# ---------------------------------------------------------------------------
# 语义检索（P0-B）
# ---------------------------------------------------------------------------
# embedding 模型名（OpenAI 兼容 /embeddings）。
# 留空 = 不构造 embedding 客户端，semantic_search 走纯词法 + 符号/依赖图
# —— 功能可用，只是精度降一档。绝不因为探不到端点而失败。
# 注意：若配成公网端点，源码片段会离开本机，这是你的显式选择（ADR-005/012）。
VIBE_EMBED_MODEL=

# 单次建索引最多读多少个文件，防止超大仓库把内存与耗时拉爆
VIBE_SEMANTIC_MAX_FILES=800

# ---------------------------------------------------------------------------
# 增量索引 / 文件监听（P1-9）
# ---------------------------------------------------------------------------
# 是否后台监听工作区文件变化并增量更新索引。默认 false（行为与改造前逐字节一致：
# 不启线程、不做额外索引）。开启后用 (mtime_ns, size) 快照轮询 diff，
# 纯 stdlib、不引入 watchdog（见 ADR-012 红线），索引只驻内存、不落盘（ADR-013）。
# 1 = 开启；0 = 关闭。
VIBE_INDEX_WATCH=0

# 轮询间隔（秒）。强制下限 2（低于 2 会被抬到 2），避免高频 stat 拖慢工作区。
VIBE_INDEX_WATCH_INTERVAL=5

# ---------------------------------------------------------------------------
# 内联补全 / 行内改写（P0-D）
# ---------------------------------------------------------------------------
# 补全是否优先走 FIM（/completions + suffix）。0 = 直接 chat()。
# 上游不支持 FIM 时也会自动回退（能力探测结果按客户端实例缓存，见 ADR-012）。
# 补全只产文本、不落盘，因此不触发审批闸门（ADR-011）。
VIBE_FIM=1

# 单次补全的输出 token 上限。补全贵在「快」，给太大反而拖慢首字
VIBE_COMPLETION_MAX_TOKENS=256

# 喂给模型的光标前 / 后上下文字符数（行对齐截断）。0 = 不截断。
# 大文件不能整份上送，否则 token 不可控、首字变慢；前后端用同一套截断算法，
# 后端为权威裁断。前缀保留尾部整行、后缀保留头部整行（不喂半行给模型）。
VIBE_COMPLETION_PREFIX_CHARS=4000
VIBE_COMPLETION_SUFFIX_CHARS=2000

# ---------------------------------------------------------------------------
# 语言服务器 / LSP（P0-E）
# ---------------------------------------------------------------------------
# 开关，取值 auto / on / off（非法值在启动前直接报错，不静默兜底）：
#   auto（默认）— 用 shutil.which 探测到语言服务器就启用，探不到就静默降级；
#   on           — 强制要求；探测不到时端点仍返回 available:false 及原因，
#                  **不做任何远端回退**（本机 stdio 是唯一形态，见 ADR-014）；
#   off          — 完全关闭：不探测、不启动任何子进程。
# 探测表：python→pyright-langserver/pylsp、js/ts→typescript-language-server、
# go→gopls、rust→rust-analyzer。缺哪个就少哪个语言的诊断，不影响其它功能。
VIBE_LSP=auto

# 空闲多少秒后自动 shutdown 语言服务器进程（**不常驻**）。0 = 不自动回收。
VIBE_LSP_IDLE=300

# ---------------------------------------------------------------------------
# 外部 MCP server（P1-6）
# ---------------------------------------------------------------------------
# 是否接入外部 MCP server。默认 false（行为与改造前逐字节一致：不读配置、
# 不起任何 MCP 子进程）。开启后按下面的配置文件发现工具并并入工具清单，
# 工具名形如 mcp__<server>__<tool>（前缀隔离）。
# 注意：外部工具**恒 REVIEW**、每次调用都需人工审批，且不可配置放行（见 ADR-015）。
# 1 = 开启；0 = 关闭。
VIBE_MCP=0

# MCP servers 配置文件路径（JSON）。留空 = <工作区>/.vibe/mcp.json。
# server 的 command/args 只取自该文件，**绝不接受运行时用户输入拼命令**；
# 子进程以 shell=False 直启、cwd 锁工作区、env 过 scrub_env() 剥离凭据。
VIBE_MCP_CONFIG=

# 单个 MCP 请求（initialize / tools/list / tools/call）的超时（秒）。
VIBE_MCP_TIMEOUT=30

# ---------------------------------------------------------------------------
# 交互式终端（P1-7）
# ---------------------------------------------------------------------------
# 是否启用交互式终端（用户在 IDE 里直接敲命令的 PTY）。默认 true。
# 0 = 关闭：界面隐藏终端页签、/api/term/* 拒绝，Agent 通道不受影响。
# 注意：终端是**用户本人动作**，不走审批浮层，但 term.open/term.close 记审计；
# 它与 Agent 通道**彻底隔离**——Agent 仍只能走受审批的 run_command（见 ADR-016）。
VIBE_TERM=1

# 终端启动的 shell 可执行文件。留空 = 按平台默认：
# Unix 用 $SHELL（缺则 sh），Windows 用 powershell.exe。
VIBE_TERM_SHELL=

# 同时存在的终端会话上限。达到上限时 open 明确拒绝。
VIBE_TERM_MAX=3

# ---------------------------------------------------------------------------
# 多模态图片输入（P1-10）
# ---------------------------------------------------------------------------
# 图片输入模式：off / auto / on。默认 off —— 图片会**随请求发往你配置的模型端点**，
# 该端点非本地时图片会离开本机，因此必须显式开启：
#   off  = 关闭：界面隐藏选图入口、image 引用降级为提示、请求体逐字节不变；
#   auto = 首次带图探测上游是否支持，400/422 且报错含图片相关词即永久回退为纯文本；
#   on   = 假定上游支持，不做探测（带图直接发）。
# 图片只落本机 <工作区>/.vibe/images/；审计 image.upload 只记 {bytes, ext, digest}。
VIBE_VISION=off

# 单张图片字节上限（落盘前校验）。超过即拒绝，提示压缩后重试或调大本值。
VIBE_VISION_MAX_BYTES=4000000

# ---------------------------------------------------------------------------
# 规则与记忆体系（P2-15）
# ---------------------------------------------------------------------------
# 仓库级规则文件的**附加目录**（glob，相对工作区）。
# 规则按「用户级 → 仓库级 → 附加目录 → 目录级」多层合并；单层无抬头
# （逐字节兼容改造前），多层各带一行 `### 规则来源：<source>` 抬头。
# 仓库级 = VIBE.md；用户级 = ~/.vibe/rules.md（存在才读）。
VIBE_RULES_EXTRA=

# 是否启用跨会话记忆（本地 SQLite 记忆库）。默认 true。
# 0 = 关闭：不建库、不注入、不注册 remember 工具，行为与改造前逐字节一致。
# 记忆正文属**不可信内容**，检索注入时一律 wrap_untrusted 包裹。
VIBE_MEMORY=1

# 记忆库容量上限（条）。达上限时写入明确拒绝（不静默淘汰）。
VIBE_MEMORY_MAX=200

# 单轮任务最多注入几条相关记忆（按词法相关度取 top-N）。0 = 不注入。
VIBE_MEMORY_INJECT=5

# 记忆库文件路径。留空 = ~/.vibe/memories.db（用户级，跨工作区）。
VIBE_MEMORY_DB=

# 注意：remember 工具**恒为 REVIEW 级**（必须人工审批），不可配置关闭（ADR-008）。
# 记忆会被注入后续每轮提示，是持久化注入面，故写入一定经用户确认，禁止静默自动学习。

# ---------------------------------------------------------------------------
# 多 Agent 编排（M3）
# ---------------------------------------------------------------------------
# 是否启用主从只读子 Agent。默认 false（行为与改造前逐字节一致：不注册 task 工具、
# 无 run.subagent 事件、工具清单不变）。开启后父 Agent 可经 task 工具派生一个**只读**
# 子 Agent 做探索/分析/检索，子 Agent 把结论压成要点回传（见 ADR-022）。
# 边界：子 Agent **只读**（只读白名单 + allow_write=False 纵深防御）、**无递归**
# （子表不含 task）、**共用父的审计实例**（否则哈希链断裂）、写盘一律回到父走审批。
# 1 = 开启；0 = 关闭。
VIBE_SUBAGENT=0

# 单个子 Agent 的迭代上限（独立于父的 VIBE_MAX_ITERATIONS）。默认 8。
# 上限越低越省 token，但复杂探索可能探索不完；子 Agent 恒只读，无写盘/无命令。
VIBE_SUBAGENT_MAX_ITERATIONS=8

# ---------------------------------------------------------------------------
# 检索增强 / Repo Wiki（M3+）
# ---------------------------------------------------------------------------
# 语义检索增强。默认 false（行为与改造前逐字节一致：分词/分块/融合都走旧路径）。
# 开启后 semantic_search 走三处增强：① 标识符子词化（getUserName → get/user/name）、
# ② 符号感知分块（块边界优先对齐函数/类起点）、③ 词法+向量 RRF 融合并按文件去冗余。
# **不新增依赖**：embedding 仍是可选端点（VIBE_EMBED_MODEL），缺则回退纯词法。
# 1 = 开启；0 = 关闭。
VIBE_RETRIEVAL_ENHANCED=0

# 是否启用 Repo Wiki 生成。默认 false（行为与改造前逐字节一致：不注册 repo_wiki 工具、
# 工具清单不变）。开启后 Agent 可用 repo_wiki 生成**本机代码结构**驱动的 markdown Wiki
# （总览 + 模块页）；落盘恒走结构化补丁 + 审批（ADR-004），正文不出机（ADR-006）。
# 1 = 开启；0 = 关闭。
VIBE_WIKI=0

# Wiki 落点（相对工作区的目录）。默认 docs/wiki。
# **不要设成 .vibe/** —— 那是审计与检查点专用目录，会被 PathGuard 拒绝写入。
VIBE_WIKI_DIR=docs/wiki

# 单次生成最多覆盖多少个源文件（防止超大仓库拉爆内存与耗时；超出会显式截断标注）。默认 400。
VIBE_WIKI_MAX_FILES=400

# ---------------------------------------------------------------------------
# 治理面接入（M2 接线 / M3 落地）
# ---------------------------------------------------------------------------
# 治理面服务地址。留空 = 未接入治理面，纯本地（M0/M1）行为一行不变。
# 设置且登录过：启动时拉策略收紧本机配置、模型请求走网关（客户端永不持云端
# 密钥）、审计事件上报服务端。治理是增强而非单点依赖：服务端不可达时降级本地继续。
VIBE_SERVER_URL=

# 网关的 OpenAI 兼容基址。留空 = 由 VIBE_SERVER_URL 派生
# （<server>/api/v1/gateway/v1）。只有网关部署在另一台机器上时才需单独指定。
VIBE_GATEWAY_URL=

# 策略缓存超过该秒数视为过期，进入受限模式（仅本地、写操作强制审批）。
# 0 = 不做过期判定（单机内网、服务端常驻的场景可接受）。
VIBE_POLICY_MAX_STALENESS=0

# ---------------------------------------------------------------------------
# 审计
# ---------------------------------------------------------------------------
# 是否记录审计日志。默认 true，落盘在 <工作区>/.vibe/audit.jsonl
VIBE_AUDIT=true

# 会话 ID。留空则每次启动自动生成。
# 服务端统一部署时可由网关注入，便于把同一次任务的多条记录关联起来。
VIBE_SESSION_ID=
